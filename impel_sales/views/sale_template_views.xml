<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Record to add custom fields in Quotation form view -->
    <record id="view_quotation_template_form_inherit" model="ir.ui.view">
        <field name="name">quotation.template.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_discount_wizard']" position="after">
                <button name="action_open_pf_charges_wizard"
                        string="Add P&#38;F Charges"
                        type="object"
                        class="btn-secondary"
                        icon="fa-plus"/>
            </xpath>

            <xpath expr="//field[@name='tax_totals']" position="before">
                <field name="amount_pf" readonly="1" widget="monetary"
                    options="{'currency_field': 'currency_id'}"
                    string="PF Charges"/>
                <!-- <field name="amount_untaxed"/> -->
            </xpath>

            <xpath expr="//group[@name='sale_total']/field[@name='tax_totals']" position="after">
                <field name="is_enabled_roundoff"/>
                <field name="amount_total_with_pf" readonly="1"/>
                <field name="amount_total_rounded" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                
            </xpath>

            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="gr_no"/>
                <field name="transport"/>
                <field name="vehicle_no"/>
                <field name="transport_type"/>
                <field name="way_bill_no"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="po_number"/>
                <field name="po_date"/>
                <field name="user_id"/>
                <field name="warehouse_id" options="{'no_create': True}" groups="stock.group_stock_multi_warehouses" force_save="1" readonly="state == 'sale'"/>
            </xpath>

            <xpath expr="//form" position="inside">
                <field name="show_lot_wise" invisible="1"/>
            </xpath>

            <!-- (NEW) Code to add Split Lot-Wise button starts -->
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']" position="before">
                <div style="display: flex; flex-direction: row-reverse; margin: 10px;">
                    <!-- SHOW button -->
                    <button name="action_toggle_lot_wise" type="object" string="Show Lot/Serial-wise Data" class="btn-primary" invisible="show_lot_wise == True"/>

                    <!-- HIDE button -->
                    <button name="action_toggle_lot_wise" type="object" string="Hide Lot/Serial-wise Data" class="btn-secondary" invisible ="show_lot_wise == False"/>
                </div>
            </xpath>
            <!-- (NEW) Code to add Split Lot-Wise button ends -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="custom_salesperson"/>
            </xpath>
        </field>
    </record>  

    <!-- (NEW) Code to display lot/serial numbers on Invoice starts -->
    <record id="view_invoice_form_inherit_lot_numbers" model="ir.ui.view">
        <field name="name">account.move.form.inherit.lot.numbers</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add Delivered Lot/Serial Number column in invoice lines -->
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="after">
                <field name="lot_numbers" readonly="1"/>
            </xpath>
        </field>
    </record>
    <!-- (NEW) Code to display lot/serial numbers on Invoice ends --> 
</odoo>