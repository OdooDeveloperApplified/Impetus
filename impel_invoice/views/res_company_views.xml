<odoo>
    <record id="view_company_form_inherit_branch_code" model="ir.ui.view">
        <field name="name">res.company.form.branch.code</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <!-- Add inside General Information -->
            <xpath expr="//field[@name='vat']" position="after">
                <field name="branch_code"/>
            </xpath>

        </field>
    </record>

    <record id="view_invoice_form_inherit_custom_salesperson" model="ir.ui.view">
        <field name="name">account.move.form.inherit.custom.salesperson</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add Delivered Lot/Serial Number column in invoice lines -->
            <xpath expr="//field[@name='l10n_in_gst_treatment']" position="after">
                <field name="is_from_sale_order" invisible="True"/>
                <field name="custom_salesperson"  readonly="is_from_sale_order"/>
            </xpath>
        </field>
    </record>
</odoo>