<odoo>
    <record id="mrp_production_form_inherit_internal_transfer" model="ir.ui.view">
        <field name="name">mrp.production.form.internal.transfer</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_internal_transfers"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange">

                    <field name="internal_transfer_count" widget="statinfo"
                        string="Internal Transfers"/>
                </button>
            </xpath>
            
            <xpath expr="//header" position="inside">
                <!-- Purple button (visible only when draft & no transfer) -->
                <button name="action_create_internal_transfer"
                        string="Create Internal Transfer"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft' or internal_transfer_count > 0"/>

                <!-- Grey button (visible when transfer exists) -->
                <button name="action_create_internal_transfer"
                        string="Internal Transfer Created"
                        type="object"
                        class="btn-secondary"
                        invisible="internal_transfer_count == 0"
                        readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="create_date"/>
                <field name="length"/>
            </xpath>
        </field>
    </record>
    <record id="mrp_production_tree_inherit_internal_transfer" model="ir.ui.view">
        <field name="name">mrp.production.tree.internal.transfer</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="create_date"/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_bom_form_formula" model="ir.ui.view">
        <field name="name">mrp.bom.form.formula</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']/tree/field[@name='product_qty']" position="after">
                <field name="formula_qty"/>
            </xpath>
        </field>
    </record>
</odoo>